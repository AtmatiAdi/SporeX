; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is human-readable and editable.

config_version=5

[application]

config/name="SporeX"
config/description="Procedural galaxy-to-cell demo. No loading screens, one continuous scale."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GraphicsSettings="*res://scripts/settings/graphics_settings.gd"
NetManager="*res://scripts/net/net_manager.gd"
Updater="*res://scripts/core/updater.gd"

[debug]

gdscript/warnings/untyped_declaration=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048

[shader_globals]

sx_tan_half_fov={
"type": "float",
"value": 0.5774
}
sx_viewport_height={
"type": "float",
"value": 720.0
}
